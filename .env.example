# Contact form SMTP. Option A: Zoho Mail on a paid plan (Mail Free has no IMAP/POP/SMTP access).
# Option B: ZeptoMail (Zoho Transactional Emails): host smtp.zeptomail.com, port 465,
# user emailapikey, password = Send Mail token, and CONTACT_FROM_EMAIL on the verified domain.
#
# Zoho Mail SMTP (set these in Vercel > Project > Settings > Environment Variables).
# The From address is always ZOHO_SMTP_USER; Zoho rejects mail "from" any other address.
# Use an app-specific password if two-factor authentication is enabled on the mailbox.
# Host is smtp.zoho.com (free) or smtppro.zoho.com (paid org); AU data centre accounts use the .com.au variants.
ZOHO_SMTP_HOST=smtppro.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=admin@mbscaustralia.com.au
ZOHO_SMTP_PASS=
CONTACT_TO_EMAIL=admin@mbscaustralia.com.au
# Optional with Zoho Mail (defaults to ZOHO_SMTP_USER); required with ZeptoMail.
CONTACT_FROM_EMAIL=

# Local development: log enquiries instead of sending them.
CONTACT_DRY_RUN=true

# Show the sample (unapproved) testimonials for layout preview only. Never enable in production.
PUBLIC_SHOW_SAMPLE_TESTIMONIALS=false
