---
import { Picture } from 'astro:assets';
import Icon, { type IconName } from './ui/Icon.astro';
import { localizePath, toLocale, useT } from '../i18n/utils';
import type { Service } from '../lib/queries';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
  showCapabilities?: boolean;
  wide?: boolean;
}
const { service, headingLevel: H = 'h3', showCapabilities = false, wide = false } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useT(locale);
const s = service.data;
const href = localizePath(`/services/${s.slug}`, locale);
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-lg bg-white ring-1 ring-line transition-shadow duration-300 hover:shadow-lift">
  <div class:list={['aspect-[3/2] overflow-hidden bg-navy-100', wide && 'lg:aspect-[16/7]']}>
    <Picture
      src={s.image}
      alt=""
      formats={['avif', 'webp']}
      widths={[400, 640, 900]}
      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
    />
  </div>
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <div class="mb-4 inline-flex size-10 items-center justify-center rounded-md bg-navy-50 text-navy-700 ring-1 ring-navy-100">
      <Icon name={s.icon as IconName} size={20} />
    </div>
    <H class="font-display text-xl font-bold text-ink-900">
      <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">{s.title}</a>
    </H>
    <p class="mt-3 flex-1 leading-7 text-ink-500">{s.short}</p>
    {
      showCapabilities && (
        <ul class="mt-5 space-y-2 border-t border-line pt-5 text-sm text-ink-700">
          {s.capabilities.slice(0, 4).map((c) => (
            <li class="flex gap-2">
              <Icon name="check" size={16} class="mt-1 text-brand-magenta" />
              {c}
            </li>
          ))}
        </ul>
      )
    }
    <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-navy-700 group-hover:text-navy-950" aria-hidden="true">
      {t.common.learnMore}
      <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none" />
    </span>
  </div>
  <span class="pointer-events-none absolute inset-0 rounded-lg ring-2 ring-transparent group-has-[a:focus-visible]:ring-brand-violet" aria-hidden="true"></span>
</article>
