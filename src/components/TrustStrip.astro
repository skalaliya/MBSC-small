---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { toLocale, useT } from '../i18n/utils';

/** Minimum number of confirmed clients before the strip is shown; one logo alone looks thin. */
const MIN_LOGOS = 3;
const t = useT(toLocale(Astro.currentLocale));
const clients = (await getCollection('clients')).filter((c) => c.data.confirmed);
---

{clients.length >= MIN_LOGOS && (
  <section class="border-b border-line bg-white py-10" aria-label={t.home.trust.title}>
    <div class="container-site flex flex-col items-center gap-6 lg:flex-row lg:gap-12">
      <p class="shrink-0 text-center text-sm font-medium text-ink-500 lg:max-w-44 lg:text-left">
        {t.home.trust.title}
      </p>
      <ul class="grid w-full grid-cols-2 items-center gap-x-10 gap-y-6 sm:grid-cols-3 lg:flex lg:justify-between">
        {clients.map((c) => (
          <li class="flex justify-center">
            <Image
              src={c.data.logo}
              alt={c.data.name}
              height={36}
              class="h-8 w-auto opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0 sm:h-9"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
