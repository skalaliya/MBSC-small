---
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';
import Icon from './ui/Icon.astro';
import { toLocale, useT } from '../i18n/utils';
import { site } from '../data/site';

interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
const t = useT(toLocale(Astro.currentLocale));
---

<Section tone="navy" grid labelledby="regions-title">
  <SectionHeading id="regions-title" eyebrow={eyebrow} title={title} dark />
  <ol class="grid gap-px overflow-hidden rounded-lg bg-white/10 md:grid-cols-3">
    {
      site.regions.map((r, i) => (
        <li class="bg-navy-950 p-7 sm:p-8">
          <div class="flex items-center justify-between">
            <Icon name="globe" size={22} class="text-brand-lilac" />
            <span class="font-display text-sm font-bold text-navy-200 tabular-nums">0{i + 1}</span>
          </div>
          <h3 class="mt-6 font-display text-2xl font-bold text-white">{t.common.regions[r]}</h3>
          <p class="mt-3 leading-7 text-navy-200">{t.common.regionsLong[r]}</p>
        </li>
      ))
    }
  </ol>
</Section>
