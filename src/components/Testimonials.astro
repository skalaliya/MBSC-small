---
import { getCollection } from 'astro:content';
import { PUBLIC_SHOW_SAMPLE_TESTIMONIALS } from 'astro:env/client';
import Icon from './ui/Icon.astro';
import SectionHeading from './ui/SectionHeading.astro';
import Section from './ui/Section.astro';
import { toLocale, useT } from '../i18n/utils';

const locale = toLocale(Astro.currentLocale);
const t = useT(locale);
const showSamples = PUBLIC_SHOW_SAMPLE_TESTIMONIALS === true;
const items = (await getCollection('testimonials'))
  .filter((q) => q.data.approved || showSamples)
  .slice(0, 3);
---

{items.length > 0 && (
  <Section tone="paper" labelledby="testimonials-title">
    <SectionHeading
      id="testimonials-title"
      eyebrow={t.home.testimonials.eyebrow}
      title={t.home.testimonials.title}
    />
    <ul class="grid gap-6 md:grid-cols-3">
      {items.map((q) => (
        <li class="flex flex-col rounded-lg bg-white p-7 ring-1 ring-line">
          <Icon name="quote" size={28} class="text-brand-magenta" />
          <blockquote class="mt-4 flex-1 text-lg leading-8 text-ink-900">
            <p>{q.data.quote[locale]}</p>
          </blockquote>
          <footer class="mt-6 border-t border-line pt-4 text-sm">
            <p class="font-semibold text-ink-900">{q.data.role[locale]}</p>
            <p class="text-ink-500">{q.data.organisation[locale]}</p>
            {!q.data.approved && (
              <p class="mt-2 text-xs font-semibold tracking-wide text-warning uppercase">
                {t.testimonials.sample}
              </p>
            )}
          </footer>
        </li>
      ))}
    </ul>
  </Section>
)}
