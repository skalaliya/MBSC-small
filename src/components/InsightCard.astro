---
import { Picture } from 'astro:assets';
import Icon from './ui/Icon.astro';
import { fmtCount, localizePath, toLocale, useT } from '../i18n/utils';
import { formatInsightDate } from '../lib/insights';
import { readingMinutes, type Insight } from '../lib/queries';

interface Props {
  insight: Insight;
  headingLevel?: 'h2' | 'h3';
}
const { insight, headingLevel: H = 'h3' } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useT(locale);
const a = insight.data;
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-lg bg-white ring-1 ring-line transition-shadow duration-300 hover:shadow-lift">
  <div class="relative aspect-[16/9] overflow-hidden bg-navy-100">
    <Picture
      src={a.cover}
      alt=""
      formats={['avif', 'webp']}
      widths={[400, 640, 900]}
      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
    />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-xs font-semibold tracking-[0.1em] text-brand-violet uppercase">
      {a.tags.map((tag) => t.insights.tags[tag]).join(' · ')}
    </p>
    <H class="mt-3 font-display text-lg leading-snug font-bold text-ink-900">
      <a
        href={localizePath(`/insights/${a.slug}`, locale)}
        class="after:absolute after:inset-0 focus-visible:outline-none"
      >
        {a.title}
      </a>
    </H>
    <p class="mt-2 flex-1 text-[0.9375rem] leading-7 text-ink-500">{a.description}</p>
    <p class="mt-5 flex items-center gap-3 text-sm text-ink-500">
      <time datetime={a.date}>{formatInsightDate(a.date, locale)}</time>
      <span aria-hidden="true">·</span>
      <span class="inline-flex items-center gap-1">
        <Icon name="clock" size={14} />
        {fmtCount(t.insights.readingTime, readingMinutes(insight.body), locale)}
      </span>
    </p>
  </div>
  <span
    class="pointer-events-none absolute inset-0 rounded-lg ring-2 ring-transparent group-has-[a:focus-visible]:ring-brand-violet"
    aria-hidden="true"
  ></span>
</article>
