---
import Icon from './ui/Icon.astro';
import Button from './ui/Button.astro';
import { fmt, localizePath, toLocale, useT } from '../i18n/utils';
import { TOPICS } from '../lib/content';
import { LIMITS } from '../lib/contact-rules';
import { site } from '../data/site';

const locale = toLocale(Astro.currentLocale);
const t = useT(locale);
const f = t.contact.form;
const privacyLink = `<a href="${localizePath('/privacy', locale)}" class="font-medium text-navy-700 underline underline-offset-4">${f.privacyLink}</a>`;
const [consentBefore, consentAfter] = f.consent.split('{privacy}');
// Error messages the script shows, resolved on the server so the client needs no dictionary.
const messages = {
  required: f.errors.required,
  email: f.errors.email,
  phone: f.errors.phone,
  tooShort: fmt(f.errors.tooShort, { min: LIMITS.messageMin }),
  tooLong: fmt(f.errors.tooLong, { max: LIMITS.messageMax }),
  consent: f.errors.consent,
  summary: f.errors.summary,
  send: fmt(f.errors.send, { email: site.email }),
  unavailable: fmt(f.errors.unavailable, { email: site.email, phone: site.phone }),
  tooFast: f.errors.tooFast,
  invalid: fmt(f.errors.send, { email: site.email }),
  origin: fmt(f.errors.send, { email: site.email }),
  sending: f.sending,
  submit: f.submit,
};
const input =
  'mt-1.5 block w-full rounded-sm border-0 bg-white px-3.5 py-3 text-ink-900 ring-1 ring-line ring-inset placeholder:text-ink-500 focus:ring-2 focus:ring-navy-700 aria-[invalid=true]:ring-2 aria-[invalid=true]:ring-danger';
const label = 'block text-sm font-medium text-ink-900';
const hint = 'mt-1.5 text-sm text-danger';
---

<div id="enquiry" class="scroll-mt-28 rounded-lg bg-paper p-6 ring-1 ring-line sm:p-8" data-contact>
  <form
    method="post"
    action="/api/contact"
    novalidate
    class="space-y-6"
    data-contact-form
    data-messages={JSON.stringify(messages)}
    aria-labelledby="form-title"
  >
    <div>
      <h2 id="form-title" class="font-display text-2xl font-bold">{f.title}</h2>
      <p class="mt-1 text-sm text-ink-500">{t.contact.lead}</p>
    </div>

    <div class="hidden rounded-md border-l-4 border-danger bg-[#fdf0f0] p-4 text-sm text-ink-900" role="alert" data-form-alert tabindex="-1"></div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <label for="firstName" class={label}>{f.firstName} <span class="text-danger" aria-hidden="true">*</span></label>
        <input id="firstName" name="firstName" type="text" autocomplete="given-name" required maxlength={LIMITS.name} class={input} aria-describedby="firstName-error" />
        <p id="firstName-error" class={hint} data-error-for="firstName" hidden></p>
      </div>
      <div>
        <label for="lastName" class={label}>{f.lastName} <span class="text-danger" aria-hidden="true">*</span></label>
        <input id="lastName" name="lastName" type="text" autocomplete="family-name" required maxlength={LIMITS.name} class={input} aria-describedby="lastName-error" />
        <p id="lastName-error" class={hint} data-error-for="lastName" hidden></p>
      </div>
      <div>
        <label for="email" class={label}>{f.email} <span class="text-danger" aria-hidden="true">*</span></label>
        <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength={LIMITS.email} class={input} aria-describedby="email-error" />
        <p id="email-error" class={hint} data-error-for="email" hidden></p>
      </div>
      <div>
        <label for="phone" class={label}>{f.phone} <span class="font-normal text-ink-500">({f.optional})</span></label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="25" class={input} aria-describedby="phone-error" />
        <p id="phone-error" class={hint} data-error-for="phone" hidden></p>
      </div>
      <div>
        <label for="company" class={label}>{f.company} <span class="font-normal text-ink-500">({f.optional})</span></label>
        <input id="company" name="company" type="text" autocomplete="organization" maxlength={LIMITS.company} class={input} />
      </div>
      <div>
        <label for="topic" class={label}>{f.topic}</label>
        <select id="topic" name="topic" class={input}>
          {TOPICS.map((k) => <option value={k}>{f.topics[k]}</option>)}
        </select>
      </div>
    </div>

    <div class="hidden rounded-md bg-white p-4 text-sm ring-1 ring-line" data-ref-box>
      <span class="font-medium text-ink-500">{f.regarding}:</span>
      <span class="ml-1 font-semibold text-ink-900" data-ref-text></span>
    </div>
    <input type="hidden" name="ref" value="" />

    <div>
      <label for="message" class={label}>{f.message} <span class="text-danger" aria-hidden="true">*</span></label>
      <textarea id="message" name="message" rows="6" required minlength={LIMITS.messageMin} maxlength={LIMITS.messageMax} class={input} aria-describedby="message-hint message-error"></textarea>
      <p id="message-hint" class="mt-1.5 text-sm text-ink-500">{f.messageHint}</p>
      <p id="message-error" class={hint} data-error-for="message" hidden></p>
    </div>

    <div>
      <label class="flex gap-3 text-sm leading-6 text-ink-700">
        <input id="consent" name="consent" type="checkbox" required class="mt-1 size-4 shrink-0 rounded-sm accent-navy-700" aria-describedby="consent-error" />
        <span>{consentBefore}<Fragment set:html={privacyLink} />{consentAfter}</span>
      </label>
      <p id="consent-error" class={hint} data-error-for="consent" hidden></p>
    </div>

    <!-- Honeypot: hidden from people and assistive tech; bots tend to fill it. -->
    <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
      <label for="website">{f.honeypot}</label>
      <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="locale" value={locale} />
    <input type="hidden" name="page" value="" />
    <input type="hidden" name="startedAt" value="" />

    <div class="flex flex-wrap items-center gap-4">
      <Button type="submit" size="lg" iconEnd="send" data-submit>{f.submit}</Button>
      <p class="text-sm text-ink-500"><span class="text-danger">*</span> {f.required}</p>
    </div>
  </form>

  <div class="hidden text-center" data-contact-success tabindex="-1" role="status">
    <span class="mx-auto flex size-14 items-center justify-center rounded-full bg-[#effaf2] text-success">
      <Icon name="circle-check" size={28} />
    </span>
    <h2 class="mt-5 font-display text-2xl font-bold">{f.success.title}</h2>
    <p class="mx-auto mt-2 max-w-md leading-7 text-ink-700">{f.success.body}</p>
    <button type="button" class="mt-6 text-sm font-semibold text-navy-700 underline-offset-4 hover:underline" data-contact-again>{f.success.again}</button>
  </div>
</div>

<script>
  import { initContactForm } from '../scripts/contact-form';
  initContactForm();
</script>
