---
import { Image } from 'astro:assets';
import roundel from '../assets/logo/mbsc-roundel.png';
import Icon from './ui/Icon.astro';
import { NAV } from './nav';
import { fmt, localizePath, toLocale, useT } from '../i18n/utils';
import { site } from '../data/site';
import { getServices } from '../lib/queries';

const locale = toLocale(Astro.currentLocale);
const t = useT(locale);
const L = (p: string) => localizePath(p, locale);
const services = await getServices(locale);
const year = new Date().getFullYear();
const address = [
  site.address.street,
  `${site.address.locality} ${site.address.region} ${site.address.postcode ?? ''}`.trim(),
]
  .filter(Boolean)
  .join(', ');
---

<footer class="bg-navy-950 pb-24 text-navy-200 lg:pb-0" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">
    {t.a11y.footerNav}
  </h2>
  <div class="h-1 bg-brand-gradient" aria-hidden="true"></div>
  <div class="container-site grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-12 lg:py-20">
    <div class="lg:col-span-4">
      <a href={L('/')} class="inline-flex items-center gap-4" aria-label={t.a11y.homeLink}>
        <Image src={roundel} alt="" width={72} height={72} densities={[1, 2]} class="size-18" />
        <span class="leading-tight">
          <span class="block font-display text-lg font-extrabold tracking-[0.04em] text-white">
            MBSC AUSTRALIA
          </span>
          <span class="block text-xs tracking-[0.08em] text-navy-200 uppercase">Pty Ltd</span>
        </span>
      </a>
      <p class="mt-6 max-w-sm leading-7">{t.footer.tagline}</p>
      {site.linkedin && (
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex size-10 items-center justify-center rounded-sm bg-white/5 text-white ring-1 ring-white/10 hover:bg-white/10"
        >
          <Icon name="linkedin" size={18} label={`${t.footer.linkedin} ${t.a11y.externalLink}`} />
        </a>
      )}
    </div>

    <nav class="lg:col-span-3" aria-label={t.footer.services}>
      <h3 class="text-xs font-semibold tracking-[0.12em] text-white uppercase">
        {t.footer.services}
      </h3>
      <ul class="mt-5 space-y-3">
        {services.map((s) => (
          <li>
            <a href={L(`/services/${s.data.slug}`)} class="hover:text-white">
              {s.data.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="lg:col-span-2" aria-label={t.footer.company}>
      <h3 class="text-xs font-semibold tracking-[0.12em] text-white uppercase">
        {t.footer.company}
      </h3>
      <ul class="mt-5 space-y-3">
        {NAV.filter((n) => n.key !== 'services' && n.key !== 'ai').map((n) => (
          <li>
            <a href={L(n.path)} class="hover:text-white">
              {t.nav[n.key]}
            </a>
          </li>
        ))}
        <li>
          <a href={L('/rental')} class="hover:text-white">
            {t.nav.rental}
          </a>
        </li>
      </ul>
    </nav>

    <div class="lg:col-span-3">
      <h3 class="text-xs font-semibold tracking-[0.12em] text-white uppercase">
        {t.footer.contact}
      </h3>
      <ul class="mt-5 space-y-4">
        <li class="flex gap-3">
          <Icon name="map-pin" size={18} class="mt-1 text-brand-lilac" />
          <span>{address || t.contact.office.addressFallback}</span>
        </li>
        <li class="flex gap-3">
          <Icon name="phone" size={18} class="mt-1 text-brand-lilac" />
          <a href={site.phoneHref} class="tabular-nums hover:text-white">
            {site.phone}
          </a>
        </li>
        <li class="flex gap-3">
          <Icon name="mail" size={18} class="mt-1 text-brand-lilac" />
          <a href={`mailto:${site.email}`} class="break-all hover:text-white">
            {site.email}
          </a>
        </li>
        <li class="flex gap-3">
          <Icon name="clock" size={18} class="mt-1 text-brand-lilac" />
          <span>{t.common.hours}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-site flex flex-col gap-4 py-6 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year} {site.legalName}. {t.footer.rights}
        {site.abn && <span class="ml-1">{fmt(t.footer.abn, { abn: site.abn })}</span>}
      </p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li>
          <a href={L('/privacy')} class="hover:text-white">
            {t.footer.privacy}
          </a>
        </li>
        <li>
          <a href={L('/terms')} class="hover:text-white">
            {t.footer.terms}
          </a>
        </li>
        <li>
          <a href="/sitemap-index.xml" class="hover:text-white">
            {t.footer.sitemap}
          </a>
        </li>
        <li>
          <a href={L('/credits')} class="hover:text-white">
            {t.footer.credits}
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
