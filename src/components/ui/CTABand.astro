---
import Button from './Button.astro';
interface Props {
  title: string;
  lead?: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const { title, lead, primary, secondary } = Astro.props;
---

<section class="bg-paper py-16 sm:py-20" aria-label={title}>
  <div class="container-site" data-reveal>
    <div class="relative isolate overflow-hidden rounded-lg bg-navy-950 px-6 py-12 sm:px-12 sm:py-16">
      <div class="absolute inset-0 -z-10 plan-grid" aria-hidden="true"></div>
      <div
        class="absolute -top-24 -end-24 -z-10 size-72 rounded-full bg-brand-violet/25 blur-3xl"
        aria-hidden="true"
      ></div>
      <div
        class="absolute -bottom-24 -start-24 -z-10 size-72 rounded-full bg-brand-rose/15 blur-3xl"
        aria-hidden="true"
      ></div>
      <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-2xl">
          <span class="datum-rule mb-5" aria-hidden="true"></span>
          <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">{title}</h2>
          {lead && <p class="mt-4 text-lg leading-8 text-navy-200">{lead}</p>}
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:shrink-0">
          <Button href={primary.href} variant="inverse" size="lg" iconEnd="arrow-right">
            {primary.label}
          </Button>
          {secondary && (
            <Button href={secondary.href} variant="outline-inverse" size="lg">
              {secondary.label}
            </Button>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
