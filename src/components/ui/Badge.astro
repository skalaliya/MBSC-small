---
interface Props {
  tone?: 'neutral' | 'navy' | 'brand' | 'dark' | 'muted';
  /** Tailwind background class for a leading colour dot, e.g. "bg-cat-oilgas". */
  dot?: string;
  class?: string;
}
const { tone = 'neutral', dot, class: className } = Astro.props;
const tones = {
  neutral: 'bg-white text-ink-700 ring-1 ring-line ring-inset',
  navy: 'bg-navy-100 text-navy-900',
  brand: 'bg-[#fbeaf4] text-brand-magenta',
  dark: 'bg-white/10 text-white ring-1 ring-white/15 ring-inset',
  muted: 'bg-paper text-ink-500 ring-1 ring-line ring-inset',
};
---

<span class:list={['inline-flex items-center gap-1.5 rounded-sm px-2 py-1 text-xs font-medium leading-none', tones[tone], className]}>
  {dot && <span class:list={['size-2 rounded-full', dot]} aria-hidden="true" />}
  <slot />
</span>
