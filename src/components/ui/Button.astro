---
import Icon, { type IconName } from './Icon.astro';

type Variant = 'primary' | 'secondary' | 'inverse' | 'outline-inverse' | 'ghost' | 'ghost-inverse';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  href?: string;
  variant?: Variant;
  size?: Size;
  type?: 'button' | 'submit' | 'reset';
  iconStart?: IconName;
  iconEnd?: IconName;
  external?: boolean;
  full?: boolean;
  class?: string;
  'aria-label'?: string;
  'data-track'?: string;
  id?: string;
  disabled?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  iconStart,
  iconEnd,
  external = false,
  full = false,
  class: className,
  disabled,
  ...attrs
} = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2 rounded-sm font-semibold leading-none tracking-[0.01em] transition-colors duration-200 disabled:cursor-not-allowed disabled:opacity-60 motion-reduce:transition-none';
const sizes: Record<Size, string> = {
  sm: 'h-9 px-3.5 text-sm',
  md: 'h-11 px-5 text-[0.9375rem]',
  lg: 'h-13 px-6 text-base',
};
const variants: Record<Variant, string> = {
  primary: 'bg-navy-700 text-white hover:bg-navy-900 shadow-sm',
  secondary:
    'bg-white text-navy-900 ring-1 ring-line ring-inset hover:ring-navy-200 hover:bg-navy-50',
  inverse: 'bg-white text-navy-950 hover:bg-navy-100',
  'outline-inverse':
    'text-white ring-1 ring-white/30 ring-inset hover:bg-white/10 hover:ring-white/50',
  ghost: 'px-0 h-auto text-navy-700 hover:text-navy-950 underline-offset-4 hover:underline',
  'ghost-inverse': 'px-0 h-auto text-white hover:text-navy-100 underline-offset-4 hover:underline',
};
const classes = [
  base,
  variant.startsWith('ghost') ? 'text-[0.9375rem]' : sizes[size],
  variants[variant],
  full && 'w-full',
  className,
];
const iconSize = size === 'lg' ? 20 : 18;
const arrow = iconEnd === 'arrow-right' || iconEnd === 'chevron-right';
---

{href ? (
  <a
    href={href}
    class:list={classes}
    {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    {...attrs}
  >
    {iconStart && <Icon name={iconStart} size={iconSize} />}
    <slot />
    {iconEnd && (
      <Icon
        name={iconEnd}
        size={iconSize}
        class={
          arrow
            ? 'transition-transform duration-200 group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 motion-reduce:transition-none'
            : ''
        }
      />
    )}
  </a>
) : (
  <button type={type} class:list={classes} disabled={disabled} {...attrs}>
    {iconStart && <Icon name={iconStart} size={iconSize} />}
    <slot />
    {iconEnd && <Icon name={iconEnd} size={iconSize} />}
  </button>
)}
