---
import Icon from './Icon.astro';
interface Props {
  items: readonly { q: string; a: string }[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<div class:list={['divide-y divide-line border-y border-line', className]}>
  {
    items.map((item) => (
      <details class="group py-1 [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-4 font-display text-lg font-semibold text-ink-900 hover:text-navy-700">
          <span>{item.q}</span>
          <Icon name="chevron-down" size={20} class="mt-1 text-ink-500 transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none" />
        </summary>
        <p class="max-w-3xl pb-5 leading-7 text-ink-700">{item.a}</p>
      </details>
    ))
  }
</div>
