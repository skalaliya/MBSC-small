---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Callout from '../components/ui/Callout.astro';
import Icon from '../components/ui/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CTABand from '../components/ui/CTABand.astro';
import { fmt, localizePath, toLocale, useT } from '../i18n/utils';
import { getProjects, getServices, type Project } from '../lib/queries';
import { breadcrumbs } from '../lib/jsonld';

interface Props {
  entry: Project;
}
const { entry } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useT(locale);
const L = (p: string) => localizePath(p, locale);
const p = entry.data;
const all = await getProjects(locale);
const more = all.filter((o) => o.data.sector === p.sector && o.data.slug !== p.slug).slice(0, 3);
const fallback = more.length ? more : all.filter((o) => o.data.slug !== p.slug).slice(0, 3);
const services = (await getServices(locale)).filter((s) => p.services.includes(s.data.slug));
const path = L(`/projects/${p.slug}`);
const crumbs = [
  { label: t.nav.home, href: L('/') },
  { label: t.nav.projects, href: L('/projects') },
  { label: p.title, href: path },
];
const meta = [
  { label: t.common.client, value: p.client ?? t.common.confidentialClient },
  { label: t.common.location, value: p.location },
  { label: t.common.sector, value: t.projects.sectors[p.sector] },
  ...(p.year ? [{ label: t.common.year, value: p.year }] : []),
];
---

<Base title={`${p.title} | MBSC Australia`} description={p.summary} jsonLd={[breadcrumbs(crumbs)]}>
  <PageHeader eyebrow={t.projects.eyebrow} title={p.title} lead={p.summary} crumbs={crumbs} crumbLabel={t.a11y.breadcrumb} meta={meta} />

  <div class="bg-navy-950">
    <div class="container-site">
      <Picture
        src={p.image}
        alt={p.imageAlt}
        formats={['avif', 'webp']}
        widths={[640, 1024, 1440, 1920]}
        sizes="(min-width: 1280px) 1216px, 100vw"
        loading="eager"
        class="aspect-[16/9] w-full translate-y-12 rounded-lg object-cover shadow-2xl ring-1 ring-white/10 sm:aspect-[21/9]"
      />
    </div>
  </div>

  <Section tone="surface" labelledby="challenge-title" innerClass="pt-12">
    <div class="grid gap-12 lg:grid-cols-12">
      <article class="space-y-12 lg:col-span-8">
        <section>
          <h2 id="challenge-title" class="font-display text-2xl font-bold sm:text-3xl">{t.projects.detail.challenge}</h2>
          <p class="mt-4 text-lg leading-8 text-ink-700">{p.challenge}</p>
        </section>
        <section>
          <h2 class="font-display text-2xl font-bold sm:text-3xl">{t.projects.detail.approach}</h2>
          <ol class="mt-6 space-y-4">
            {
              p.approach.map((step, i) => (
                <li class="flex gap-4">
                  <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-navy-50 font-display text-sm font-bold text-navy-700 ring-1 ring-navy-100 tabular-nums">
                    {i + 1}
                  </span>
                  <span class="pt-1 text-lg leading-7 text-ink-700">{step}</span>
                </li>
              ))
            }
          </ol>
        </section>
        <section>
          <h2 class="font-display text-2xl font-bold sm:text-3xl">{t.projects.detail.outcome}</h2>
          <Callout tone="brand" class="mt-6 text-base">
            <p class="text-lg leading-8 text-ink-900">{p.outcome}</p>
          </Callout>
        </section>
      </article>
      <aside class="lg:col-span-4">
        <div class="rounded-lg bg-paper p-6 ring-1 ring-line lg:sticky lg:top-28">
          <h2 class="font-display text-lg font-bold">{t.projects.detail.keyFacts}</h2>
          <dl class="mt-4 divide-y divide-line text-sm">
            {
              [...meta, ...p.facts].map((f) => (
                <div class="flex justify-between gap-4 py-3">
                  <dt class="text-ink-500">{f.label}</dt>
                  <dd class="text-right font-medium text-ink-900">{f.value}</dd>
                </div>
              ))
            }
          </dl>
          {
            services.length > 0 && (
              <div class="mt-6 border-t border-line pt-6">
                <h3 class="text-xs font-semibold tracking-[0.12em] text-ink-500 uppercase">{t.common.services}</h3>
                <ul class="mt-3 space-y-2">
                  {services.map((s) => (
                    <li>
                      <a href={L(`/services/${s.data.slug}`)} class="inline-flex items-center gap-1.5 font-medium text-navy-700 hover:text-navy-950">
                        {s.data.title}
                        <Icon name="arrow-right" size={15} />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </aside>
    </div>
  </Section>

  <Section tone="paper" labelledby="more-title">
    <SectionHeading
      id="more-title"
      title={more.length ? fmt(t.projects.detail.more, { sector: t.projects.sectors[p.sector].toLowerCase() }) : t.home.projects.title}
    />
    <ul class="grid gap-6 md:grid-cols-3">
      {fallback.map((o) => <li><ProjectCard project={o} /></li>)}
    </ul>
  </Section>

  <CTABand title={t.projects.ctaTitle} lead={t.projects.ctaLead} primary={{ label: t.cta.primary, href: L('/contact') }} />
</Base>
