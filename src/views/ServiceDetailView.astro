---
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Prose from '../components/ui/Prose.astro';
import Icon from '../components/ui/Icon.astro';
import Button from '../components/ui/Button.astro';
import CTABand from '../components/ui/CTABand.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SessionRow from '../components/SessionRow.astro';
import { fmt, localizePath, toLocale, useT } from '../i18n/utils';
import { getCalendars, getProjects, getServices, upcoming, type Service } from '../lib/queries';
import { breadcrumbs, service as serviceLd } from '../lib/jsonld';

interface Props {
  entry: Service;
}
const { entry } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useT(locale);
const L = (p: string) => localizePath(p, locale);
const s = entry.data;
const { Content } = await render(entry);
const related = (await getProjects(locale)).filter((p) => p.data.services.includes(s.slug)).slice(0, 3);
const others = (await getServices(locale)).filter((o) => o.data.slug !== s.slug);
const sessions = s.categories.length
  ? upcoming(await getCalendars(), new Date(), 40).filter((x) => (s.categories as string[]).includes(x.category)).slice(0, 4)
  : [];
const path = L(`/services/${s.slug}`);
const crumbs = [
  { label: t.nav.home, href: L('/') },
  { label: t.nav.services, href: L('/services') },
  { label: s.title, href: path },
];
const contactHref = `${L('/contact')}?topic=${s.topic}`;
---

<Base
  title={`${s.title} | MBSC Australia`}
  description={s.short}
  jsonLd={[breadcrumbs(crumbs), serviceLd({ name: s.title, description: s.short, url: path })]}
>
  <PageHeader eyebrow={t.services.eyebrow} title={s.title} lead={s.short} crumbs={crumbs} crumbLabel={t.a11y.breadcrumb}>
    <Button slot="actions" href={contactHref} variant="inverse" iconEnd="arrow-right">{t.services.detail.ctaPrimary}</Button>
  </PageHeader>

  <Section tone="surface" labelledby="overview-title">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-7">
        <h2 id="overview-title" class="mb-6 font-display text-3xl font-bold">{t.services.detail.overview}</h2>
        <Prose><Content /></Prose>
        <h3 class="mt-10 font-display text-xl font-bold">{t.services.capabilities}</h3>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {
            s.capabilities.map((c) => (
              <li class="flex gap-3 rounded-md bg-paper p-4 ring-1 ring-line">
                <Icon name="check" size={18} class="mt-0.5 text-brand-magenta" />
                <span class="text-ink-900">{c}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <Picture
          src={s.image}
          alt={s.imageAlt}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          loading="eager"
          class="aspect-[4/3] w-full rounded-lg object-cover"
        />
        <div class="mt-6 rounded-lg bg-navy-950 p-6 text-navy-100">
          <h3 class="font-display text-lg font-bold text-white">{t.services.detail.deliverables}</h3>
          <ul class="mt-4 space-y-3">
            {
              s.deliverables.map((d) => (
                <li class="flex gap-3">
                  <Icon name="file-check-2" size={18} class="mt-0.5 text-brand-lilac" />
                  {d}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="paper" labelledby="process-title">
    <SectionHeading id="process-title" title={t.services.detail.process} />
    <ol class="grid gap-px overflow-hidden rounded-lg bg-line md:grid-cols-3">
      {
        s.process.map((step, i) => (
          <li class="bg-white p-7">
            <span class="font-display text-sm font-bold text-brand-magenta tabular-nums">0{i + 1}</span>
            <h3 class="mt-3 font-display text-xl font-bold">{step.title}</h3>
            <p class="mt-3 leading-7 text-ink-500">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  {
    related.length > 0 && (
      <Section tone="surface" labelledby="related-title">
        <SectionHeading id="related-title" title={t.services.detail.relatedProjects} />
        <ul class="grid gap-6 md:grid-cols-3">
          {related.map((p) => <li><ProjectCard project={p} /></li>)}
        </ul>
      </Section>
    )
  }

  {
    sessions.length > 0 && (
      <Section tone={related.length > 0 ? 'paper' : 'surface'} labelledby="courses-title">
        <SectionHeading id="courses-title" title={t.services.detail.relatedCourses}>
          <Button slot="action" href={L('/training')} variant="secondary" iconEnd="arrow-right">{t.home.training.all}</Button>
        </SectionHeading>
        <ul class="divide-y divide-line border-y border-line">
          {sessions.map((x) => <SessionRow session={x} year={x.year} compact />)}
        </ul>
      </Section>
    )
  }

  <Section tone="surface" labelledby="others-title" spacing="sm">
    <h2 id="others-title" class="mb-6 text-xs font-semibold tracking-[0.12em] text-ink-500 uppercase">{t.services.detail.otherServices}</h2>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        others.map((o) => (
          <li>
            <a href={L(`/services/${o.data.slug}`)} class="group flex h-full items-center justify-between gap-3 rounded-md p-4 ring-1 ring-line hover:bg-paper hover:ring-navy-200">
              <span class="font-semibold text-ink-900">{o.data.title}</span>
              <Icon name="arrow-right" size={18} class="text-navy-700 transition-transform group-hover:translate-x-0.5" />
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <CTABand title={fmt(t.services.detail.ctaTitle, { service: s.title.toLowerCase() })} lead={t.cta.lead} primary={{ label: t.services.detail.ctaPrimary, href: contactHref }} />
</Base>
