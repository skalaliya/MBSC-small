---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Callout from '../components/ui/Callout.astro';
import { fmt, intlLocale, localizePath, toLocale, useT } from '../i18n/utils';
import { breadcrumbs } from '../lib/jsonld';
import { parseISODate } from '../lib/dates';
import { site } from '../data/site';

interface Props {
  kind: 'privacy' | 'terms';
}
const { kind } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useT(locale);
const doc = t.legal[kind];
const L = (p: string) => localizePath(p, locale);
const UPDATED = '2026-09-25';
const updated = new Intl.DateTimeFormat(intlLocale[locale], { dateStyle: 'long' }).format(
  parseISODate(UPDATED),
);
const crumbs = [
  { label: t.nav.home, href: L('/') },
  { label: doc.title, href: L(`/${kind}`) },
];
---

<Base
  title={t.meta.pages[kind].title}
  description={t.meta.pages[kind].description}
  jsonLd={[breadcrumbs(crumbs)]}
>
  <PageHeader
    title={doc.title}
    lead={fmt(t.legal.updated, { date: updated })}
    crumbs={crumbs}
    crumbLabel={t.a11y.breadcrumb}
  />
  <div class="bg-white py-16 sm:py-20">
    <div class="container-site max-w-3xl">
      {kind === 'privacy' && (
        <Callout tone="warning" class="mb-10">
          {t.legal.reviewNotice}
        </Callout>
      )}
      <div class="space-y-10">
        {doc.sections.map((s) => (
          <section>
            <h2 class="font-display text-2xl font-bold">{s.heading}</h2>
            {s.body.map((p) => (
              <p class="mt-4 text-lg leading-8 text-ink-700">{fmt(p, { email: site.email })}</p>
            ))}
          </section>
        ))}
      </div>
    </div>
  </div>
</Base>
