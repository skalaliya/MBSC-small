---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import StatBand from '../components/StatBand.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import UpcomingSessions from '../components/UpcomingSessions.astro';
import Testimonials from '../components/Testimonials.astro';
import GlobalPresence from '../components/GlobalPresence.astro';
import AiArchitectureDiagram from '../components/AiArchitectureDiagram.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import CTABand from '../components/ui/CTABand.astro';
import { fmt, localizePath, toLocale, useT } from '../i18n/utils';
import { getProjects, getServices } from '../lib/queries';
import { organization, website } from '../lib/jsonld';
import { site } from '../data/site';

const locale = toLocale(Astro.currentLocale);
const t = useT(locale);
const L = (p: string) => localizePath(p, locale);
const services = await getServices(locale);
// Three per row; when the last row would hold two cards, widen them to fill it.
const wideLast = (i: number) => services.length % 3 === 2 && i >= services.length - 2;
const featured = (await getProjects(locale)).filter((p) => p.data.featured).slice(0, 3);
---

<Base
  title={t.meta.pages.home.title}
  description={t.meta.pages.home.description}
  jsonLd={[organization(), website(locale)]}
>
  <Hero />
  <TrustStrip />

  <section class="bg-navy-950 pt-4 pb-16 sm:pb-20" aria-label={t.stats.labels.projects}>
    <div class="container-site" data-reveal>
      <StatBand />
    </div>
  </section>

  <Section tone="surface" labelledby="ai-teaser-title" spacing="lg">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <SectionHeading
          id="ai-teaser-title"
          eyebrow={t.ai.teaser.eyebrow}
          title={t.ai.teaser.title}
          lead={t.ai.teaser.lead}
          class="mb-8"
        />
        <Button
          href={L('/services/ai-mining')}
          variant="primary"
          size="lg"
          iconEnd="arrow-right"
          data-track="home_ai"
        >
          {t.ai.teaser.cta}
        </Button>
      </div>
      <div class="relative isolate overflow-hidden rounded-lg bg-navy-950 p-6 sm:p-8 lg:col-span-7">
        <div class="absolute inset-0 -z-10 plan-grid" aria-hidden="true"></div>
        <div
          class="absolute -top-20 -right-20 -z-10 size-64 rounded-full bg-brand-violet/30 blur-3xl"
          aria-hidden="true"
        ></div>
        <AiArchitectureDiagram compact />
      </div>
    </div>
  </Section>

  <Section tone="paper" labelledby="services-title">
    <SectionHeading
      id="services-title"
      eyebrow={t.home.services.eyebrow}
      title={t.home.services.title}
      lead={t.home.services.lead}
    >
      <Button slot="action" href={L('/services')} variant="secondary" iconEnd="arrow-right">
        {t.services.title}
      </Button>
    </SectionHeading>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-6">
      {services.map((s, i) => (
        <li class:list={[wideLast(i) ? 'lg:col-span-3' : 'lg:col-span-2']}>
          <ServiceCard service={s} wide={wideLast(i)} />
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="surface" labelledby="process-title">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading
          id="process-title"
          eyebrow={t.home.process.eyebrow}
          title={t.home.process.title}
          class="mb-0"
        />
      </div>
      <ol class="grid gap-px overflow-hidden rounded-lg bg-line sm:grid-cols-3 lg:col-span-8">
        {t.home.process.steps.map((step, i) => (
          <li class="bg-white p-7">
            <span class="font-display text-sm font-bold text-brand-magenta tabular-nums">
              0{i + 1}
            </span>
            <h3 class="mt-3 font-display text-xl font-bold">{step.title}</h3>
            <p class="mt-3 leading-7 text-ink-500">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <Section tone="paper" labelledby="projects-title">
    <SectionHeading
      id="projects-title"
      eyebrow={t.home.projects.eyebrow}
      title={t.home.projects.title}
    >
      <Button slot="action" href={L('/projects')} variant="secondary" iconEnd="arrow-right">
        {t.home.projects.all}
      </Button>
    </SectionHeading>
    <ul class="grid gap-6 md:grid-cols-3">
      {featured.map((p) => (
        <li>
          <ProjectCard project={p} />
        </li>
      ))}
    </ul>
  </Section>

  <GlobalPresence />

  <Section tone="surface" labelledby="training-title">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading
          id="training-title"
          eyebrow={t.home.training.eyebrow}
          title={t.home.training.title}
          lead={t.training.calendar.lead}
          class="mb-8"
        />
        <Button href={L('/training')} variant="primary" iconEnd="arrow-right">
          {t.home.training.all}
        </Button>
      </div>
      <div class="lg:col-span-8">
        <UpcomingSessions limit={4} />
      </div>
    </div>
  </Section>

  <Testimonials />
  <CTABand
    title={t.home.cta.title}
    lead={t.home.cta.lead}
    primary={{ label: t.home.cta.primary, href: L('/contact') }}
    secondary={{ label: fmt(t.home.cta.secondary, { phone: site.phone }), href: site.phoneHref }}
  />
</Base>
