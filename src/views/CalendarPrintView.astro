---
/**
 * Printable A4 calendar for one year. Not indexed; scripts/make-calendar-pdf.mjs renders it to
 * public/downloads/*.pdf, and visitors can also print it from the browser.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { fmt, fmtCount, intlLocale, localizePath, toLocale, useT } from '../i18n/utils';
import { CATEGORY_DOT } from '../lib/content';
import { formatRange, parseISODate } from '../lib/dates';
import { getCalendarState, sessionDates } from '../lib/queries';
import { daysInclusive } from '../lib/dates';
import { site } from '../data/site';
import roundel from '../assets/logo/mbsc-roundel.png';

interface Props {
  year: number;
}
const { year } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useT(locale);
const c = t.training.calendar;
const p = t.training.launch.print;
const state = await getCalendarState();
const calendar = state.calendars.find((x) => x.year === year);
if (!calendar) throw new Error(`No calendar for ${year}`);

const monthName = (m: number) => {
  const name = new Intl.DateTimeFormat(intlLocale[locale], { month: 'long' }).format(
    new Date(year, m - 1, 1),
  );
  return name.charAt(0).toLocaleUpperCase(intlLocale[locale]) + name.slice(1);
};
const dated = calendar.sessions
  .filter((s) => s.start !== null)
  .sort((a, b) => a.start!.localeCompare(b.start!));
const months = Array.from({ length: 12 }, (_, i) => i + 1)
  .map((m) => ({ m, sessions: dated.filter((s) => s.month === m) }))
  .filter((x) => x.sessions.length > 0);
const onRequest = calendar.sessions.filter((s) => s.start === null);
const updated = new Intl.DateTimeFormat(intlLocale[locale], { dateStyle: 'long' }).format(
  parseISODate(state.today),
);
const website = site.url.replace(/^https?:\/\//, '');
---

<Base
  title={fmt(p.docTitle, { year })}
  description={fmt(t.meta.pages.training.description, { year })}
  noindex
  bare
>
  <article class="print-doc mx-auto max-w-4xl bg-white px-6 py-10 text-ink-900 print:p-0">
    <header class="flex items-start justify-between gap-6 border-b-2 border-navy-950 pb-5">
      <div class="flex items-center gap-4">
        <Image src={roundel} alt="" width={64} height={64} class="size-16" />
        <div>
          <p class="font-display text-sm font-bold tracking-wide uppercase">{site.name}</p>
          <h1 class="font-display text-3xl font-bold tracking-tight">{fmt(c.title, { year })}</h1>
        </div>
      </div>
      <a
        href={`${localizePath('/training', locale)}#calendar`}
        class="text-sm font-semibold text-navy-700 underline underline-offset-4 print:hidden"
      >
        {fmt(t.training.launch.view, { year })}
      </a>
    </header>
    <p class="mt-4 text-sm leading-6 text-ink-500">{c.lead}</p>

    {months.map(({ m, sessions }) => (
      <section class="mt-7" aria-labelledby={`pm-${m}`}>
        <h2 id={`pm-${m}`} class="break-after-avoid font-display text-lg font-bold text-navy-950">
          {monthName(m)} {year}
        </h2>
        <table class="mt-2 w-full border-collapse text-start text-sm">
          <thead class="break-after-avoid">
            <tr class="border-b border-line text-xs text-ink-500">
              <th scope="col" class="w-32 py-1.5 pe-3 text-start font-medium">
                {p.date}
              </th>
              <th scope="col" class="py-1.5 pe-3 text-start font-medium">
                {p.course}
              </th>
              <th scope="col" class="w-28 py-1.5 pe-3 text-start font-medium">
                {p.format}
              </th>
              <th scope="col" class="w-28 py-1.5 pe-3 text-start font-medium">
                {c.location}
              </th>
              <th scope="col" class="w-16 py-1.5 text-start font-medium">
                {p.length}
              </th>
            </tr>
          </thead>
          <tbody>
            {sessions.map((s) => {
              const d = sessionDates(s)!;
              return (
                <tr class="break-inside-avoid border-b border-line/70 align-top">
                  <td class="py-2 pe-3 font-medium tabular-nums">
                    {formatRange(d.start, d.end, intlLocale[locale])}
                  </td>
                  <td class="py-2 pe-3">
                    <span class="font-medium">{s.title[locale]}</span>
                    <span class="mt-0.5 flex items-center gap-1.5 text-xs text-ink-500">
                      <span
                        class:list={['size-2 rounded-full', CATEGORY_DOT[s.category]]}
                        aria-hidden="true"
                      />
                      {c.categories[s.category]}
                    </span>
                  </td>
                  <td class="py-2 pe-3">{c.deliveryModes[s.delivery]}</td>
                  <td class="py-2 pe-3">{c.locations[s.location]}</td>
                  <td class="py-2 tabular-nums">
                    {fmtCount(c.days, daysInclusive(d.start, d.end), locale)}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>
    ))}

    {onRequest.length > 0 && (
      <section class="mt-8 break-inside-avoid" aria-labelledby="p-onrequest">
        <h2 id="p-onrequest" class="font-display text-lg font-bold text-navy-950">
          {p.onRequestTitle}
        </h2>
        <ul class="mt-2 space-y-1 text-sm">
          {onRequest.map((s) => (
            <li>
              <span class="font-medium">{s.title[locale]}</span> · {c.deliveryModes[s.delivery]} ·{' '}
              {c.locations[s.location]}
            </li>
          ))}
        </ul>
      </section>
    )}

    <footer class="mt-10 break-inside-avoid border-t-2 border-navy-950 pt-4 text-sm leading-6">
      <p class="text-ink-700">{c.notice}</p>
      <p class="mt-2 font-semibold">
        {p.contact}: <span dir="ltr">{site.email}</span> · <span dir="ltr">{site.phone}</span> ·{' '}
        <span dir="ltr">{website}</span>
      </p>
      <p class="mt-1 text-xs text-ink-500">{fmt(p.updated, { date: updated })}</p>
    </footer>
  </article>
</Base>

<style>
  @page {
    size: A4;
    margin: 14mm 12mm;
  }
  @media print {
    :global(body) {
      background: white;
    }
  }
</style>
