---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/ui/FAQ.astro';
import CTABand from '../components/ui/CTABand.astro';
import Icon from '../components/ui/Icon.astro';
import header from '../assets/images/header-offshore-night.jpg';
import { localizePath, toLocale, useT } from '../i18n/utils';
import { getServices } from '../lib/queries';
import { breadcrumbs, faqPage, service as serviceLd } from '../lib/jsonld';

const locale = toLocale(Astro.currentLocale);
const t = useT(locale);
const L = (p: string) => localizePath(p, locale);
const services = await getServices(locale);
const crumbs = [
  { label: t.nav.home, href: L('/') },
  { label: t.nav.services, href: L('/services') },
];
const whyIcons = ['users', 'file-check-2', 'graduation-cap'] as const;
---

<Base
  title={t.meta.pages.services.title}
  description={t.meta.pages.services.description}
  jsonLd={[
    breadcrumbs(crumbs),
    faqPage(t.faq.services),
    ...services.map((s) => serviceLd({ name: s.data.title, description: s.data.short, url: L(`/services/${s.data.slug}`) })),
  ]}
>
  <PageHeader eyebrow={t.services.eyebrow} title={t.services.title} lead={t.services.lead} crumbs={crumbs} crumbLabel={t.a11y.breadcrumb} image={header} imageAlt="" />

  <Section tone="paper" labelledby="services-list">
    <h2 id="services-list" class="sr-only">{t.services.title}</h2>
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => <li><ServiceCard service={s} headingLevel="h3" showCapabilities /></li>)}
    </ul>
  </Section>

  <Section tone="surface" labelledby="why-title">
    <SectionHeading id="why-title" title={t.services.whyTitle} />
    <ul class="grid gap-8 md:grid-cols-3">
      {
        t.services.why.map((w, i) => (
          <li class="border-t-2 border-navy-950 pt-6">
            <Icon name={whyIcons[i] ?? 'check'} size={24} class="text-brand-magenta" />
            <h3 class="mt-4 font-display text-xl font-bold">{w.title}</h3>
            <p class="mt-2 leading-7 text-ink-500">{w.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="paper" labelledby="faq-title">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading id="faq-title" title={t.services.faqTitle} class="mb-0" />
      </div>
      <FAQ items={t.faq.services} class="lg:col-span-8" />
    </div>
  </Section>

  <CTABand title={t.services.ctaTitle} lead={t.services.ctaLead} primary={{ label: t.cta.primary, href: L('/contact') }} />
</Base>
