---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import { en } from '../i18n/en';
import { site } from '../data/site';
import { htmlDir, htmlLang, localizePath, publishedLocales, useT } from '../i18n/utils';
// The 404 page serves every URL, so it shows each public language rather than guessing.
const blocks = publishedLocales.map((locale) => ({ locale, t: useT(locale) }));
const paths = ['/services', '/training', '/contact'] as const;
const keyOf = { '/services': 'services', '/training': 'training', '/contact': 'contact' } as const;
---

<Base
  title={en.meta.pages.notFound.title}
  description={en.meta.pages.notFound.description}
  noindex
  hasAlternate={false}
>
  <section class="relative isolate overflow-hidden bg-navy-950 py-24 text-navy-100 sm:py-32">
    <div class="absolute inset-0 -z-10 plan-grid" aria-hidden="true"></div>
    <div
      class:list={[
        'container-site grid gap-16',
        blocks.length > 2 ? 'lg:grid-cols-3' : 'lg:grid-cols-2',
      ]}
    >
      {blocks.map(({ locale, t }, i) => {
        const Heading = i === 0 ? 'h1' : 'h2';
        return (
          <div lang={htmlLang[locale]} dir={htmlDir[locale]}>
            <p class="font-display text-sm font-bold tracking-[0.14em] text-brand-lilac uppercase">
              {t.notFound.eyebrow}
            </p>
            <Heading
              class:list={[
                'mt-4 font-display font-bold text-white',
                i === 0 ? 'text-4xl sm:text-5xl' : 'text-3xl sm:text-4xl',
              ]}
            >
              {t.notFound.title}
            </Heading>
            <p class="mt-4 text-lg text-navy-200">{t.notFound.lead}</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <Button href={localizePath('/', locale)} variant="inverse" iconEnd="arrow-right">
                {t.notFound.home}
              </Button>
              {paths.map((path) => (
                <Button href={localizePath(path, locale)} variant="outline-inverse">
                  {t.nav[keyOf[path]]}
                </Button>
              ))}
            </div>
          </div>
        );
      })}
    </div>
    <p class="container-site mt-16 text-sm text-navy-200">
      <a href={site.phoneHref} class="hover:text-white">
        <bdi dir="ltr">{site.phone}</bdi>
      </a>{' '}
      ·{' '}
      <a href={`mailto:${site.email}`} class="hover:text-white">
        <bdi dir="ltr">{site.email}</bdi>
      </a>
    </p>
  </section>
</Base>
