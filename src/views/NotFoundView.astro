---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import { en } from '../i18n/en';
import { fr } from '../i18n/fr';
import { site } from '../data/site';
// The 404 page serves every URL, so it shows both languages rather than guessing.
const links = [
  { href: '/services', en: en.nav.services, fr: fr.nav.services },
  { href: '/training', en: en.nav.training, fr: fr.nav.training },
  { href: '/contact', en: en.nav.contact, fr: fr.nav.contact },
];
---

<Base
  title={en.meta.pages.notFound.title}
  description={en.meta.pages.notFound.description}
  noindex
  hasAlternate={false}
>
  <section class="relative isolate overflow-hidden bg-navy-950 py-24 text-navy-100 sm:py-32">
    <div class="absolute inset-0 -z-10 plan-grid" aria-hidden="true"></div>
    <div class="container-site grid gap-16 lg:grid-cols-2">
      <div>
        <p class="font-display text-sm font-bold tracking-[0.14em] text-brand-lilac uppercase">
          {en.notFound.eyebrow}
        </p>
        <h1 class="mt-4 font-display text-4xl font-bold text-white sm:text-5xl">
          {en.notFound.title}
        </h1>
        <p class="mt-4 text-lg text-navy-200">{en.notFound.lead}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/" variant="inverse" iconEnd="arrow-right">
            {en.notFound.home}
          </Button>
          {links.map((l) => (
            <Button href={l.href} variant="outline-inverse">
              {l.en}
            </Button>
          ))}
        </div>
      </div>
      <div lang="fr">
        <p class="font-display text-sm font-bold tracking-[0.14em] text-brand-lilac uppercase">
          {fr.notFound.eyebrow}
        </p>
        <h2 class="mt-4 font-display text-3xl font-bold text-white sm:text-4xl">
          {fr.notFound.title}
        </h2>
        <p class="mt-4 text-lg text-navy-200">{fr.notFound.lead}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/fr" variant="inverse" iconEnd="arrow-right">
            {fr.notFound.home}
          </Button>
          {links.map((l) => (
            <Button href={`/fr${l.href}`} variant="outline-inverse">
              {l.fr}
            </Button>
          ))}
        </div>
      </div>
    </div>
    <p class="container-site mt-16 text-sm text-navy-200">
      <a href={site.phoneHref} class="hover:text-white">
        {site.phone}
      </a>{' '}
      ·{' '}
      <a href={`mailto:${site.email}`} class="hover:text-white">
        {site.email}
      </a>
    </p>
  </section>
</Base>
