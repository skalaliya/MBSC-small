---
import { Picture, Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Icon from '../components/ui/Icon.astro';
import StatBand from '../components/StatBand.astro';
import GlobalPresence from '../components/GlobalPresence.astro';
import TrustStrip from '../components/TrustStrip.astro';
import CTABand from '../components/ui/CTABand.astro';
import lab from '../assets/images/about-lab.jpg';
import engineers from '../assets/images/about-engineers.jpg';
import { localizePath, toLocale, useT } from '../i18n/utils';
import { breadcrumbs } from '../lib/jsonld';
import { site } from '../data/site';

const locale = toLocale(Astro.currentLocale);
const t = useT(locale);
const a = t.about;
const L = (p: string) => localizePath(p, locale);
const team = (await getCollection('team'))
  .filter((m) => !m.data.placeholder)
  .sort((x, y) => x.data.order - y.data.order);
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((w) => w[0])
    .filter(Boolean)
    .slice(0, 2)
    .join('')
    .toUpperCase();
const crumbs = [
  { label: t.nav.home, href: L('/') },
  { label: t.nav.about, href: L('/about') },
];
const valueIcons = ['file-check-2', 'shield-check', 'users'] as const;
---

<Base
  title={t.meta.pages.about.title}
  description={t.meta.pages.about.description}
  jsonLd={[breadcrumbs(crumbs)]}
>
  <PageHeader
    eyebrow={a.eyebrow}
    title={a.title}
    lead={a.lead}
    crumbs={crumbs}
    crumbLabel={t.a11y.breadcrumb}
    image={engineers}
    imageAlt=""
  />

  <Section tone="surface" labelledby="story-title">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <SectionHeading id="story-title" eyebrow={a.eyebrow} title={a.story.title} class="mb-6" />
        <div class="space-y-5 text-lg leading-8 text-ink-700">
          {a.story.body.map((p) => (
            <p>{p}</p>
          ))}
        </div>
        <div class="mt-10 rounded-lg border-l-4 border-brand-magenta bg-paper p-6">
          <h3 class="font-display text-lg font-bold">{a.mission.title}</h3>
          <p class="mt-2 text-lg leading-8 text-ink-900">{a.mission.body}</p>
        </div>
      </div>
      <div class="lg:col-span-5">
        <Picture
          src={lab}
          alt={a.story.imageAlt}
          formats={['avif', 'webp']}
          widths={[400, 640, 900]}
          sizes="(min-width: 1024px) 35vw, 100vw"
          class="mx-auto aspect-[4/5] w-full max-w-md rounded-lg object-cover shadow-lift"
        />
      </div>
    </div>
  </Section>

  <section class="bg-navy-950 py-16 sm:py-20" aria-label={a.eyebrow}>
    <div class="container-site" data-reveal>
      <StatBand />
    </div>
  </section>

  <Section tone="paper" labelledby="values-title">
    <SectionHeading id="values-title" title={a.values.title} />
    <ul class="grid gap-6 md:grid-cols-3">
      {a.values.items.map((v, i) => (
        <li class="rounded-lg bg-white p-7 ring-1 ring-line">
          <Icon name={valueIcons[i] ?? 'check'} size={24} class="text-brand-magenta" />
          <h3 class="mt-4 font-display text-xl font-bold">{v.title}</h3>
          <p class="mt-2 leading-7 text-ink-500">{v.body}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="surface" labelledby="clients-title">
    <SectionHeading
      id="clients-title"
      eyebrow={a.accreditations.eyebrow}
      title={t.home.trust.title}
    />
    <TrustStrip variant="grouped" />
  </Section>

  {team.length > 0 && (
    <Section tone="surface" labelledby="team-title" id="team">
      <SectionHeading id="team-title" eyebrow={a.team.eyebrow} title={a.team.title} />
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {team.map((m) => (
          <li class="rounded-lg bg-paper p-6 ring-1 ring-line">
            {m.data.photo ? (
              <Image
                src={m.data.photo}
                alt=""
                width={96}
                height={96}
                class="size-20 rounded-full object-cover"
              />
            ) : (
              <span
                class="flex size-20 items-center justify-center rounded-full bg-navy-950 font-display text-xl font-bold text-white"
                aria-hidden="true"
              >
                {initials(m.data.name)}
              </span>
            )}
            <h3 class="mt-4 font-display text-lg font-bold">{m.data.name}</h3>
            <p class="text-sm text-ink-500">{m.data.role[locale]}</p>
            {m.data.bio && <p class="mt-3 text-sm leading-6 text-ink-700">{m.data.bio[locale]}</p>}
          </li>
        ))}
      </ul>
    </Section>
  )}

  {site.iso9001 && (
    <Section tone="surface" labelledby="accreditations-title" id="accreditations">
      <SectionHeading
        id="accreditations-title"
        eyebrow={a.accreditations.eyebrow}
        title={a.accreditations.title}
      />
      <div class="flex items-center gap-4 rounded-lg bg-paper p-6 ring-1 ring-line">
        <Icon name="award" size={28} class="text-brand-magenta" />
        <div>
          <p class="font-semibold text-ink-900">ISO 9001 · {site.iso9001.body}</p>
          <p class="text-sm text-ink-500">
            {site.iso9001.number} · {site.iso9001.expires}
          </p>
        </div>
      </div>
    </Section>
  )}

  <GlobalPresence />
  <CTABand
    title={t.cta.title}
    lead={t.cta.lead}
    primary={{ label: t.cta.primary, href: L('/contact') }}
  />
</Base>
