---
import { getCollection } from 'astro:content';
import ServiceDetailView from '../../views/ServiceDetailView.astro';

export async function getStaticPaths() {
  // getStaticPaths runs in isolation, so this must live inside it.
  const FLAGSHIP = 'ai-mining';
  const entries = await getCollection('services', (e) => e.data.locale === 'en');
  // ai-mining has its own flagship page (services/ai-mining.astro); never generate it twice.
  return entries
    .filter((entry) => entry.data.slug !== FLAGSHIP)
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---

<ServiceDetailView entry={entry} />
