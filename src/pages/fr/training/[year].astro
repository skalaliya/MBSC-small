---
import TrainingView from '../../../views/TrainingView.astro';
import { getCalendarState } from '../../../lib/queries';

// The primary year lives at /training. Later years, and the previous year while it still has
// sessions to run, get their own page. Other years redirect (scripts/vercel-headers.mjs).
export async function getStaticPaths() {
  const { pages } = await getCalendarState();
  return pages.map((y) => ({ params: { year: String(y) } }));
}
const year = Number(Astro.params.year);
---

<TrainingView year={year} />
